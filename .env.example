GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.8-live
DHARSHINI_NAME=Dharshini
DHARSHINI_CONFIRM_RISKY=true
DHARSHINI_MEMORY_DB=data/dharshini.db
DHARSHINI_WAKE_WORD_ENABLED=true
DHARSHINI_WAKE_MODEL_PATH=models/dharshini.tflite
DHARSHINI_WAKE_THRESHOLD=0.5
DHARSHINI_SUMATRA_PATH=C:\Path\To\SumatraPDF.exe
DHARSHINI_SYSTEM_PROMPT=You are Dharshini, a capable Windows desktop AI assistant. Speak naturally and concisely. Use tools to perform requested actions. Never claim an action succeeded until the tool result confirms it. Ask for confirmation before risky or destructive actions. Never expose secrets, API keys, passwords, or private credentials.
